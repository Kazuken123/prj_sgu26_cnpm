        </mxCell>

        <mxCell id="act1" value="Khách mở thông tin chi tiết điểm tham quan&#10;và nhấn nút Phát thuyết minh" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="100" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec1" value="Đang phát dở âm thanh&#10;của điểm tham quan khác?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="175" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a1" value="A1. Dừng ngay bài cũ, giải phóng bộ phát&#10;và bắt đầu nạp âm thanh điểm mới" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="188" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="merge1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">

          <mxGeometry x="506" y="280" width="28" height="28" as="geometry" />

        </mxCell>

        <mxCell id="act2" value="Kiểm tra đường dẫn tệp âm thanh của điểm&#10;trong gói nội dung ngôn ngữ hiện tại" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="330" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec2" value="Có âm thanh theo&#10;ngôn ngữ đang chọn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="405" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="dec3" value="Có âm thanh dự phòng&#10;(Anh/Việt) AVAILABLE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="405" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e1a" value="E1. Chuyển sang âm thanh dự phòng (Anh/Việt)&#10;kèm nhãn ngôn ngữ thực tế" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="515" width="260" height="52" as="geometry" />

        </mxCell>

        <mxCell id="e1b" value="E1. Báo âm thanh chưa sẵn sàng; hiển thị&#10;nội dung văn bản để khách tự đọc" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="620" width="260" height="52" as="geometry" />

        </mxCell>

        <mxCell id="merge2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">

          <mxGeometry x="506" y="590" width="28" height="28" as="geometry" />

        </mxCell>

        <mxCell id="act3" value="Trình duyệt tải luồng dữ liệu âm thanh&#10;và bắt đầu phát ra loa ngoài hoặc tai nghe" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="645" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec4" value="Tải luồng âm thanh&#10;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="720" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e3" value="E3. Báo lỗi tải âm thanh, cho phép thử lại;&#10;hiển thị toàn bộ bài viết dạng chữ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="733" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="dec5" value="Trình duyệt chặn&#10;tự động phát âm thanh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="830" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e2" value="E2. Hiển thị thông báo yêu cầu khách chạm&#10;trực tiếp biểu tượng âm thanh để cho phép phát" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="843" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act4" value="Giao diện chuyển sang Đang phát, hiển thị&#10;thanh tiến độ thời gian và nút Tạm dừng" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

