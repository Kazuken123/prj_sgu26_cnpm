        <mxCell id="a2" value="A2. Nhấn Tạm dừng: giữ nguyên vị trí giây&#10;hiện tại để khách tiếp tục nghe bất cứ lúc nào" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

