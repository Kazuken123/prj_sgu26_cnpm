        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">

          <mxGeometry x="507" y="50" width="26" height="26" as="geometry" />

        </mxCell>

        <mxCell id="act1" value="Khách bấm nút &quot;Bắt đầu tham quan&quot; trên thanh điều khiển bản đồ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="100" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="act2" value="Ghi nhận quyền tương tác âm thanh và&#10;kích hoạt tiến trình theo dõi tọa độ GPS liên tục" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="175" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec1" value="Nhận được tọa độ&#10;định vị GPS hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="250" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e1" value="E1. Mất tín hiệu GPS/sai số lớn: tạm dừng&#10;quét tự động và nhắc kiểm tra cài đặt vị trí" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="263" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act3" value="Tính khoảng cách Haversine từ vị trí khách&#10;tới các điểm tham quan đang hoạt động trong bundle" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="360" width="340" height="52" as="geometry" />

        </mxCell>

        <mxCell id="dec2" value="Có POI đã phát nay vượt&#10;1,5 lần bán kính (≥ 75m)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="440" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a3" value="A3. Xóa cờ đã phát của POI đó để thiết lập&#10;lượt tiếp cận mới khi khách quay lại vùng" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="453" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="merge1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">

          <mxGeometry x="506" y="545" width="28" height="28" as="geometry" />

        </mxCell>

        <mxCell id="dec3" value="Có POI trong bán kính kích hoạt&#10;(trigger_radius mặc định 50m)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="595" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="out_range" value="Chưa có điểm tham quan trong vùng kích hoạt;&#10;tiếp tục theo dõi ở chu kỳ vị trí tiếp theo" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="608" width="260" height="52" as="geometry" />

        </mxCell>

        <mxCell id="dec4" value="Trùng từ hai điểm trở lên&#10;trong vùng kích hoạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="705" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a2" value="A2. Ưu tiên lựa chọn duy nhất điểm tham quan&#10;có khoảng cách gần nhất" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="718" width="260" height="52" as="geometry" />

        </mxCell>

        <mxCell id="merge2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">

          <mxGeometry x="506" y="810" width="28" height="28" as="geometry" />

        </mxCell>

        <mxCell id="dec5" value="Điểm gần nhất đã phát&#10;trong lượt tiếp cận này?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="860" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="already" value="Bỏ qua điểm đã phát; chống phát lặp lại&#10;trong cùng một lượt đến gần" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="873" width="260" height="52" as="geometry" />

        </mxCell>

        <mxCell id="dec6" value="Đang có bài thuyết minh&#10;khác phát dở?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="970" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a1" value="A1. Không ngắt quãng bài đang phát dở;&#10;xếp hàng hoặc bỏ qua để tránh gây ồn" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="983" width="260" height="52" as="geometry" />

        </mxCell>

        <mxCell id="act4" value="Tự động kích hoạt tải và phát tệp âm thanh&#10;của điểm tham quan được chọn" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="1075" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec7" value="Tệp âm thanh sẵn sàng&#10;và tải thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="1150" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e2" value="E2. Báo lỗi âm thanh, cho thử lại thủ công&#10;(không lặp liên tục); hủy nếu rời vùng/đổi ngôn ngữ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="1160" width="260" height="58" as="geometry" />

        </mxCell>

        <mxCell id="dec8" value="Trình duyệt chặn&#10;tự động phát âm thanh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="1260" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e3" value="E3. Hiển thị nút yêu cầu khách chạm trực tiếp&#10;để mở khóa phát; chưa đánh dấu điểm đã phát" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="1273" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act5" value="Bắt đầu phát âm thanh thành công; ghi nhận&#10;trạng thái đã phát trong lượt tiếp cận này" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

