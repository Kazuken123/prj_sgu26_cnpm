    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="UC-06 – NGHE THUYẾT MINH TỰ ĐỘNG THEO VỊ TRÍ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="290" y="10" width="460" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="507" y="50" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="Khách bấm nút &quot;Bắt đầu tham quan&quot; trên thanh điều khiển bản đồ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="Ghi nhận quyền tương tác âm thanh và&#10;kích hoạt tiến trình theo dõi tọa độ GPS liên tục" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="175" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="dec1" value="Nhận được tọa độ&#10;định vị GPS hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="250" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="E1. Mất tín hiệu GPS/sai số lớn: tạm dừng&#10;quét tự động và nhắc kiểm tra cài đặt vị trí" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="263" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="act3" value="Tính khoảng cách Haversine từ vị trí khách&#10;tới các điểm tham quan đang hoạt động (ACTIVE) trong bundle" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="360" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="dec2" value="Có POI đã phát nay vượt ngưỡng&#10;1,5 lần bán kính (khoảng cách &gt; 1,5 × trigger_radius)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="440" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="A1. Thiết lập lượt tiếp cận mới: Xóa cờ đã phát&#10;của POI đó để sẵn sàng tự phát lại khi khách quay lại" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="453" width="280" height="54" as="geometry" />
        </mxCell>
        <mxCell id="merge1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="506" y="545" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="dec3" value="(1) Có POI ACTIVE trong bán kính (≤ trigger_radius)&#10;VÀ chưa phát trong lượt tiếp cận hiện tại?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="595" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="out_range" value="Không có điểm hợp lệ cần kích hoạt;&#10;tiếp tục theo dõi ở chu kỳ vị trí tiếp theo" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="608" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="dec4" value="(2) Danh sách lọc được có từ hai điểm trở lên&#10;(trùng nhiều điểm trong vùng kích hoạt)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="705" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="A2. Bỏ qua điểm đã phát hoặc trùng nhiều điểm:&#10;Ưu tiên duy nhất điểm gần nhất chưa phát" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="718" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="merge2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="506" y="810" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="dec6" value="(3) Đang có bài thuyết minh&#10;khác phát dở?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="865" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="A3. Có bài thuyết minh đang phát dở: Không ngắt&#10;quãng âm thanh hiện tại mà chờ phát hết bài" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="878" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="act4" value="Tự động phát âm thanh theo ngôn ngữ hiện tại&#10;hoặc âm thanh dự phòng (English / Tiếng Việt)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="975" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="dec7" value="Âm thanh chính hoặc dự phòng&#10;sẵn sàng và tải thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="1050" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="E2. Cả âm thanh chính và dự phòng đều thiếu/lỗi;&#10;báo chưa sẵn sàng và cho phép xem văn bản" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="1060" width="260" height="58" as="geometry" />
        </mxCell>
        <mxCell id="dec8" value="Trình duyệt chặn&#10;tự động phát âm thanh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="1160" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="E3. Hiển thị nút yêu cầu khách chạm trực tiếp&#10;để mở khóa phát; chưa đánh dấu điểm đã phát" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="1173" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="act5" value="Bắt đầu phát âm thanh thành công; ghi nhận&#10;trạng thái đã phát trong lượt tiếp cận này" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="1270" width="340" height="52" as="geometry" />
