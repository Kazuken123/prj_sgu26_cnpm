      <root>

        <mxCell id="0" />

        <mxCell id="1" parent="0" />

        <mxCell id="title" value="UC-04 – LỰA CHỌN NGÔN NGỮ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">

          <mxGeometry x="310" y="10" width="420" height="30" as="geometry" />

        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">

          <mxGeometry x="507" y="50" width="26" height="26" as="geometry" />

        </mxCell>

        <mxCell id="act1" value="Khách chạm vào biểu tượng lựa chọn ngôn ngữ&#10;ở góc trên bên phải màn hình" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="100" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec1" value="Lấy được danh mục&#10;ngôn ngữ hỗ trợ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="175" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e1" value="E1. Thông báo lỗi danh mục ngôn ngữ trống;&#10;duy trì ngôn ngữ mặc định hiện tại" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="188" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act2" value="Hiển thị danh sách các ngôn ngữ đang hoạt động" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="285" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="act3" value="Khách chọn ngôn ngữ mong muốn trong danh sách" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="360" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec2" value="Trùng với ngôn ngữ&#10;đang sử dụng hiện tại?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="435" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a1" value="A1. Đóng danh sách lựa chọn; giữ nguyên&#10;dữ liệu hiện có và không gọi lại API" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="448" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act4" value="Kiểm tra phiên tham quan và gửi yêu cầu tải gói&#10;nội dung (bundle) theo mã ngôn ngữ đã chọn" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="545" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec3" value="Phiên tham quan&#10;còn hiệu lực?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="620" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e2" value="E2. Từ chối tải gói mới; chuyển khách&#10;về trang thông báo hết hạn vé" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="633" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="dec4" value="Tải gói nội dung&#10;ngôn ngữ mới thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="730" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e3" value="E3. Thông báo chưa thể chuyển ngôn ngữ;&#10;tiếp tục sử dụng dữ liệu ngôn ngữ trước đó" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="743" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act5" value="Ghi nhận lượt cấp vào BUNDLE_ACCESS_LOGS&#10;và nhận gói nội dung mới tại trình duyệt" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="840" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec5" value="Phản hồi khớp với yêu cầu&#10;ngôn ngữ mới nhất?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="915" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="stale" value="Bỏ qua phản hồi đến muộn của lần chọn trước&#10;để không ghi đè lựa chọn mới" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="928" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act6" value="Dừng/hủy luồng âm thanh ngôn ngữ cũ (nếu đang phát);&#10;thay thế bộ nhớ đệm và cập nhật giao diện, bản đồ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="1025" width="340" height="52" as="geometry" />

        </mxCell>

        <mxCell id="act7" value="Lưu mã ngôn ngữ đã chọn vào bộ nhớ cục bộ (localStorage)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

