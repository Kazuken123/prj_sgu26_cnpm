    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1260" math="0" shadow="0">

      <root>

        <mxCell id="0" />

        <mxCell id="1" parent="0" />

        <mxCell id="title" value="UC-08 – HỎI ĐÁP BẰNG CHATBOT RAG" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">

          <mxGeometry x="310" y="10" width="420" height="30" as="geometry" />

        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">

          <mxGeometry x="507" y="50" width="26" height="26" as="geometry" />

        </mxCell>

        <mxCell id="act1" value="Khách mở cửa sổ chatbot, nhập câu hỏi&#10;bằng ngôn ngữ tự nhiên và nhấn Gửi tin nhắn" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="100" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="act2" value="Kiểm tra hiệu lực phiên tham quan, dữ liệu đầu vào&#10;(không rỗng, độ dài hợp lệ) và giới hạn tần suất" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="175" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec1" value="Phiên tham quan&#10;còn hiệu lực?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="250" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e1" value="E1. Từ chối tiếp nhận câu hỏi; thông báo&#10;phiên tham quan đã hết thời hạn sử dụng" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="263" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="dec2" value="Câu hỏi hợp lệ và&#10;trong giới hạn tần suất?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="360" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e2" value="E2. Báo lỗi đầu vào hoặc vượt giới hạn tần suất;&#10;yêu cầu chờ vài giây trước khi hỏi tiếp" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="373" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="dec3" value="Câu hỏi yêu cầu thanh toán&#10;hoặc tác vụ quản trị?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="470" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a2" value="A2. Từ chối yêu cầu vượt quyền; giải thích rõ&#10;chỉ hỗ trợ thông tin tham quan chùa Linh Ứng" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="483" width="260" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act3" value="Trích xuất vector embedding câu hỏi; truy vấn&#10;KNOWLEDGE_CHUNKS thuộc tài liệu ACTIVE khớp phiên bản" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="580" width="340" height="54" as="geometry" />

        </mxCell>

        <mxCell id="act4" value="Đóng gói ngữ cảnh tài liệu kèm câu hỏi gửi tới&#10;mô hình ngôn ngữ lớn (LLM)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="660" width="340" height="48" as="geometry" />

        </mxCell>

        <mxCell id="dec4" value="Dịch vụ Embedding / LLM&#10;phản hồi thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="735" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="e3" value="E3. Ghi CHAT_LOGS trạng thái FAILED; báo lỗi AI&#10;tạm gián đoạn (không làm ngắt bản đồ/audio)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="748" width="260" height="56" as="geometry" />

        </mxCell>

        <mxCell id="dec5" value="Ngữ cảnh truy hồi đủ căn cứ&#10;để trả lời câu hỏi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="845" width="260" height="80" as="geometry" />

        </mxCell>

        <mxCell id="a1" value="A1. Trả lời lịch sự kho kiến thức chưa có thông tin&#10;chính thức; ghi nhận trạng thái NO_CONTEXT" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="858" width="260" height="56" as="geometry" />

        </mxCell>

        <mxCell id="act5" value="Tổng hợp câu trả lời theo ngôn ngữ câu hỏi&#10;kèm trích dẫn nguồn; trạng thái SUCCESS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="955" width="340" height="52" as="geometry" />

        </mxCell>

