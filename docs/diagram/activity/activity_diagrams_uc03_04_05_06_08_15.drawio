        <mxCell id="act1" value="Khách mở cửa sổ chatbot, nhập câu hỏi&#xa;bằng ngôn ngữ tự nhiên và nhấn Gửi tin nhắn" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="100" width="340" height="48" as="geometry"/>

        </mxCell>

        <mxCell id="act2" value="Kiểm tra hiệu lực phiên tham quan, dữ liệu đầu vào&#xa;(không rỗng, độ dài hợp lệ) và giới hạn tần suất" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="350" y="175" width="340" height="48" as="geometry"/>

        </mxCell>

        <mxCell id="dec1" value="Phiên tham quan&#xa;còn hiệu lực?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="250" width="260" height="80" as="geometry"/>

        </mxCell>

        <mxCell id="e1" value="E1. Từ chối tiếp nhận câu hỏi; thông báo&#xa;phiên tham quan đã hết thời hạn sử dụng" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="263" width="260" height="54" as="geometry"/>

        </mxCell>

        <mxCell id="dec2" value="Câu hỏi hợp lệ và&#xa;trong giới hạn tần suất?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="360" width="260" height="80" as="geometry"/>

        </mxCell>

        <mxCell id="e2" value="E2. Báo lỗi đầu vào hoặc vượt giới hạn tần suất;&#xa;yêu cầu chờ vài giây trước khi hỏi tiếp" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="30" y="373" width="260" height="54" as="geometry"/>

        </mxCell>

        <mxCell id="dec3" value="Câu hỏi yêu cầu thanh toán&#xa;hoặc tác vụ quản trị?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="470" width="260" height="80" as="geometry"/>

        </mxCell>

        <mxCell id="a2" value="A2. Từ chối yêu cầu vượt quyền; giải thích rõ&#xa;chỉ hỗ trợ thông tin tham quan chùa Linh Ứng" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="750" y="483" width="260" height="54" as="geometry"/>

        </mxCell>

