        </mxCell>
        <mxCell id="act4" value="Nhập tiêu đề tài liệu, nội dung văn bản chi tiết,&#10;nguồn trích dẫn và nhấn Lưu" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
