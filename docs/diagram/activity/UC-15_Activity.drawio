          <mxGeometry x="390" y="1185" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="E4. Lỗi AI hoặc lưu chunks: rollback Tx2 (nếu mở);&#10;giữ doc INACTIVE, cung cấp nút &quot;Xử lý lại&quot;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
