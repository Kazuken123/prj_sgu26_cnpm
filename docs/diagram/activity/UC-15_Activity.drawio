        </mxCell>

        <mxCell id="a1" value="A1. Ngừng sử dụng: chuyển trạng thái tài liệu sang&#10;INACTIVE, tăng content_version và ghi AUDIT_LOGS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
