        <mxCell id="dec4" value="Thêm tài liệu mới hay&#10;chỉnh sửa tài liệu cũ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
