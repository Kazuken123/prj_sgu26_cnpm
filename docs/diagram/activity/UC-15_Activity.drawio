        <mxCell id="act3" value="Hiển thị danh sách các tài liệu hiện có&#10;kèm trạng thái và phiên bản" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

