        <mxCell id="dec2" value="Thao tác nhân viên&#10;lựa chọn thực hiện?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

