        </mxCell>

        <mxCell id="dec1" value="Phiên nội bộ hợp lệ và&#10;đủ quyền STAFF/ADMIN?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

          <mxGeometry x="390" y="250" width="260" height="80" as="geometry" />

