        <mxCell id="dec5" value="Transaction 1 (Tx1) commit&#10;cơ sở dữ liệu thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="1000" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="E3. Lỗi cơ sở dữ liệu khi lưu tài liệu:&#10;rollback Transaction 1 và báo lỗi" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
