        </mxCell>
        <mxCell id="act6" value="Ngoài transaction: Chia nhỏ văn bản (chunking)&#10;và gửi yêu cầu tới dịch vụ AI sinh embedding (timeout)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="1110" width="340" height="48" as="geometry" />
        </mxCell>
