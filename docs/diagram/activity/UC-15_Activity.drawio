        </mxCell>
        <mxCell id="a2" value="A2. Cập nhật tài liệu cũ: tăng content_version,&#10;lưu KNOWLEDGE_DOCUMENTS và ghi AUDIT_LOGS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="788" width="280" height="54" as="geometry" />
        </mxCell>
        <mxCell id="act5" value="Pha 1 (Tx1): Lưu KNOWLEDGE_DOCUMENTS (trạng thái INACTIVE,&#10;tăng content_version nếu sửa) và ghi AUDIT_LOGS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
