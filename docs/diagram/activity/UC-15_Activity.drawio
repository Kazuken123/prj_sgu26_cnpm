          <mxGeometry x="390" y="665" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="E2. Thông báo lỗi trường bắt buộc; giữ nguyên&#10;biểu mẫu để nhân viên chỉnh sửa" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">
