        <mxCell id="e1" value="E1. Từ chối truy cập (401/403);&#10;chuyển về trang đăng nhập nội bộ" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;fontFamily=Arial;fontSize=11;" vertex="1" parent="1">

