PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_tour_db
## Local default: disabled. Aiven staging: verify_identity + project's public CA PEM.
DB_SSL_MODE=disabled
DB_SSL_CA=
# Generate a random secret before starting; production requires at least 32 bytes.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Only needed when explicitly running npm run bootstrap:admin:
BOOTSTRAP_ADMIN_EMAIL=admin@foodtour.com
BOOTSTRAP_ADMIN_PASSWORD=
# No default price: set the agreed price before creating new pending payments.
VISIT_PRICE_VND=
VISIT_VALIDITY_HOURS=24
CASH_CODE_TTL_SECONDS=600
ONLINE_CODE_TTL_SECONDS=900
CONTENT_JOB_LEASE_SECONDS=120
CONTENT_JOB_HEARTBEAT_SECONDS=15
# Absolute private directory when running Node directly; never inside frontend/public.
MEDIA_ROOT=
ONLINE_EXCHANGE_WINDOW_SECONDS=60
ONLINE_EXCHANGE_IP_LIMIT=30
ONLINE_EXCHANGE_SESSION_LIMIT=5
# Demo only; set PAYMENT_GATEWAY=disabled to keep mock checkout off.
PAYMENT_GATEWAY=mock
# Opt-in browser demo control; never enable for real payment acceptance.
MOCK_PAYMENT_SIMULATION_ENABLED=false
MOCK_PAYMENT_BASE_URL=http://localhost:3000
# Server/operator only; generate a separate random secret (at least 32 bytes).
MOCK_WEBHOOK_SECRET=
CASH_EXCHANGE_WINDOW_SECONDS=60
CASH_EXCHANGE_IP_LIMIT=30
CASH_EXCHANGE_SESSION_LIMIT=5
REDIS_URL=redis://127.0.0.1:6379
# Technical lookup limits, configurable; not acceptance thresholds from the report.
VISIT_LOOKUP_WINDOW_SECONDS=60
VISIT_LOOKUP_IP_LIMIT=60
VISIT_LOOKUP_SESSION_LIMIT=20
# Knowledge base / RAG chatbot (UC-15, UC-08). MOCK needs nothing else and sends no data out.
# A real provider (OPENAI_COMPATIBLE) needs an approved provider, budget and data-sharing decision.
RAG_PROVIDER=MOCK
RAG_ALLOW_EXTERNAL_PROVIDER=false
RAG_API_BASE_URL=
RAG_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=
RAG_LLM_MODEL=
RAG_EMBEDDING_TIMEOUT_MS=10000
RAG_LLM_TIMEOUT_MS=20000
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
CHAT_RATE_WINDOW_SECONDS=60
CHAT_RATE_SESSION_LIMIT=10
CHAT_RATE_IP_LIMIT=30
