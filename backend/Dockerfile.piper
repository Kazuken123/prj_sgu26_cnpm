# Optional worker image only. The default backend/frontend image stays unchanged.
FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY backend/runtime/piper-requirements.txt /opt/tcv-runtime/piper-requirements.txt
RUN python3 -m venv /opt/piper \
    && /opt/piper/bin/pip install --no-cache-dir -r /opt/tcv-runtime/piper-requirements.txt
COPY backend/runtime/piper-voices.json backend/runtime/install-piper-voices.py /opt/tcv-runtime/
RUN /opt/piper/bin/python /opt/tcv-runtime/install-piper-voices.py /opt/tcv-runtime/piper-voices.json /opt/piper-models
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --omit=dev
COPY backend/ ./
COPY data/demo/locations/positions-v1.json /data/demo/locations/positions-v1.json
COPY database/migrations/ /database/migrations/
ENV NODE_ENV=production PIPER_PYTHON=/opt/piper/bin/python PIPER_FFMPEG=/usr/bin/ffmpeg PIPER_MODEL_DIR=/opt/piper-models PIPER_TIMEOUT_MS=60000
CMD ["node", "scripts/content-worker.js", "--piper"]
