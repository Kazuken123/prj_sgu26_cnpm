# Optional Piper worker; no API key. Set database/media configuration separately.
PIPER_PYTHON=/opt/piper/bin/python
PIPER_FFMPEG=/usr/bin/ffmpeg
PIPER_MODEL_DIR=/opt/piper-models
PIPER_TIMEOUT_MS=60000
# Default vi-en is unchanged. The optional Dockerfile.piper-demo7 supplies these:
# PIPER_VOICE_SET=demo7
# PIPER_RESOURCE_DIR=/opt/piper-resources
MEDIA_ROOT=/private-media
