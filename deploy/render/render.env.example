# Template only. Enter actual credentials in Render's protected configuration.
NODE_ENV=production
DB_HOST=YOUR_SERVICE.b.aivencloud.com
DB_PORT=12834
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=tcv_demo_review_20261020
DB_SSL_MODE=verify_identity
# Paste the project's public CA PEM into this variable in Render (multiline).
DB_SSL_CA=
REDIS_URL=redis://YOUR_INTERNAL_KEY_VALUE_HOST:6379
JWT_SECRET=
MOCK_WEBHOOK_SECRET=
PAYMENT_GATEWAY=mock
MOCK_PAYMENT_SIMULATION_ENABLED=true
MEDIA_ROOT=/opt/tcv-media
STAGING_DEMO_MODE=frozen-20261023
# Only enable for an explicitly approved, empty staging database. Never reset data.
STAGING_INITIALIZE_EMPTY=false
BOOTSTRAP_ADMIN_EMAIL=admin@tcv-demo.local
BOOTSTRAP_ADMIN_PASSWORD=
# RENDER_EXTERNAL_URL is supplied by Render; startup uses it for same-origin CORS/mock.
